# Build trees (one per CMake preset) and everything mcgen downloads or extracts:
# Mojang's jars, reports, game data, the vanilla reference server and its worlds.
/build/
/.cache/
# ...and what it generates from them (their lock, src/proto/gen/v*.sha256, is kept).
/src/proto/gen/v*/
/compile_commands.json
/CMakeUserPresets.json

# Python
__pycache__/
*.pyc

# What a server started from the source tree leaves behind
/server.properties
/ops.json
/logs/
/world/

# Profiling
perf.data*

# Per-user tool state
/.claude/settings.local.json
/.claude/worktrees/
/.idea/
/.vscode/
.obsidian/
*.swp
*~
